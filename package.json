{
  "name": "publicly-verifiable-solvency-system",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --import tsx --test shared/*.test.ts arms/*/prover/*.test.ts open-solvency/src/*.test.ts open-solvency/src/solutions/*.test.ts",
    "test:integration": "node --import tsx --test arms/*/test/*.test.ts",
    "check": "tsc --noEmit",
    "web": "vite --config vite.opensolvency.config.ts",
    "web:build": "vite build --config vite.opensolvency.config.ts",
    "demo": "node --import tsx scripts/demo/run.ts",
    "test:demo": "node --import tsx --test --test-reporter=spec scripts/demo/*.test.ts",
    "ledger": "node --import tsx arms/published-ledger/cli/verify.ts",
    "inclusion": "node --import tsx arms/single-asset/cli/verify-inclusion.ts",
    "test:browser": "playwright test",
    "validate": "npm run check && forge fmt --check && forge test && npm test && npm run web:build && npm run test:demo && npm run test:browser"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.4.1",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "viem": "^2.56.3",
    "vite": "^8.2.2"
  },
  "dependencies": {
    "@noble/curves": "^1.9.1",
    "@zkpassport/poseidon2": "^0.6.2"
  }
}
