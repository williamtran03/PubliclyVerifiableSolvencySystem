{
  "name": "publicly-verifiable-solvency-system",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "node cli/build-contracts.ts",
    "test": "node --test --test-concurrency=1 prover/merkleSumTree.test.ts zk/integration.test.ts",
    "demo": "npm run typecheck && npm test",
    "anvil": "anvil --chain-id 31337",
    "deploy:local": "node cli/deploy-local.ts zk",
    "submit:local": "node cli/submit-proof.ts",
    "compile:circuit": "node zk/compile.ts",
    "generate:verifier": "node zk/prove.ts",
    "prepare": "node zk/cli.ts prepare",
    "prove": "node zk/cli.ts prove",
    "verify:customer": "node zk/cli.ts verify-customer"
  },
  "devDependencies": {
    "@aztec/bb.js": "5.2.0",
    "@ethereumjs/common": "10.1.3",
    "@ethereumjs/tx": "10.1.3",
    "@ethereumjs/util": "10.1.3",
    "@ethereumjs/vm": "10.1.3",
    "@foundry-rs/anvil": "1.7.1",
    "@noble/curves": "2.4.0",
    "@noir-lang/noir_js": "1.0.0-beta.26",
    "@noir-lang/noir_wasm": "1.0.0-beta.26",
    "@types/node": "24.13.3",
    "solc": "0.8.28",
    "tsx": "^4.23.13",
    "typescript": "5.9.3",
    "viem": "^2.56.3"
  },
  "engines": {
    "node": ">=24"
  }
}
