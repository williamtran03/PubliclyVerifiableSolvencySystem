{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "paths": {
      "@shared/*": ["./shared/*"],
      "@arms/*": ["./arms/*"]
    },
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "noEmit": true,
    "allowImportingTsExtensions": true
  },
  "exclude": ["node_modules", "lib", "out", "arms/*/circuit/target", "arms/*/site/dist", "demo-site/dist"]
}
